{
  "name": "smu-rule-mcp",
  "version": "0.0.0",
  "description": "Unofficial MCP server for Sangmyung University regulations (rule.smu.ac.kr)",
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=22.5"
  },
  "bin": {
    "smu-rule-mcp": "dist/mcp/server.js"
  },
  "files": [
    "dist",
    "LICENSE",
    "NOTICE.md",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copyAssets.mjs",
    "verify": "node scripts/verifyDb.mjs",
    "crawl": "node --enable-source-maps dist/crawler/buildDb.js",
    "start": "node dist/mcp/server.js",
    "typecheck": "tsc --noEmit",
    "update-data": "node scripts/updateData.mjs",
    "setup": "node scripts/setup.mjs",
    "check-filenames": "node scripts/checkFilenames.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "iconv-lite": "^0.6.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "typescript": "^5.6.0"
  }
}
